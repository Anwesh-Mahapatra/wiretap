# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. Empty values below are not defaults -- most
# services will refuse to start or will use a weak inline fallback from
# docker-compose.yml (marked # CHANGEME there) until you set them here.

# --- wiretap Go test driver / LiteLLM virtual keys --------------------------
# WIRETAP_KEY is the LiteLLM virtual key main.go authenticates with.
# ALICE_KEY / BOB_KEY are additional per-key-budget virtual keys used in the
# budget-enforcement experiment (see run-alice.txt / run-bob.txt / notes.md).
WIRETAP_KEY=
ALICE_KEY=
BOB_KEY=
# Only needed if LiteLLM isn't reachable at the default http://localhost:4000.
LITELLM_BASE_URL=

# --- LiteLLM proxy / Groq backend -------------------------------------------
GROQ_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# --- Langfuse -- core auth secrets -------------------------------------------
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# --- Langfuse -- API keys (used by LiteLLM's langfuse callback AND by
# wiretap's own tracescope/tracepump tools to call the Langfuse public API) --
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Read directly by LiteLLM's own Langfuse SDK integration (a LiteLLM/Langfuse
# convention, distinct from LANGFUSE_BASE_URL below). Typically the same
# reachable address as LANGFUSE_BASE_URL, e.g. http://langfuse-web:3000.
LANGFUSE_HOST=
# Used by tracescope, tracepump, and wiretapd when run from the host.
# Inside the tracepump/wiretapd containers this is overridden in
# docker-compose.yml to http://langfuse-web:3000 -- see the comment there
# for why the two must not be conflated. Defaults to http://localhost:3000
# if left blank.
LANGFUSE_BASE_URL=
# Used only by wiretapd's ECS mapper to build event.reference links (a
# Kibana alert's click-through back into Langfuse's own trace view) --
# must be whatever URL an analyst's own browser can reach, never the
# in-container service name. Inside the wiretapd container this is
# overridden in docker-compose.yml to http://localhost:3000 (the published
# host port); override that yourself if you access this stack from
# somewhere other than the Docker host. Defaults to LANGFUSE_BASE_URL, then
# http://localhost:3000, if left blank.
LANGFUSE_PUBLIC_URL=

# --- Langfuse -- database connection -----------------------------------------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_VERSION=

# --- Langfuse -- object storage (MinIO/S3) -----------------------------------
# docker-compose.yml has working inline defaults (pointing at the bundled
# minio service) for everything in this group except the two secrets.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LANGFUSE_USE_AZURE_BLOB=
LANGFUSE_USE_OCI_NATIVE_OBJECT_STORAGE=
LANGFUSE_OCI_AUTH_TYPE=
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=
LANGFUSE_S3_EVENT_UPLOAD_REGION=
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=
LANGFUSE_S3_MEDIA_UPLOAD_REGION=
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=
LANGFUSE_S3_BATCH_EXPORT_ENABLED=
LANGFUSE_S3_BATCH_EXPORT_BUCKET=
LANGFUSE_S3_BATCH_EXPORT_REGION=
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=
LANGFUSE_S3_BATCH_EXPORT_PREFIX=

# --- Langfuse -- Redis --------------------------------------------------------
REDIS_AUTH=
REDIS_HOST=
REDIS_PORT=
REDIS_TLS_ENABLED=
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK=

# --- Langfuse -- ClickHouse ----------------------------------------------------
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=
CLICKHOUSE_MIGRATION_URL=
CLICKHOUSE_CLUSTER_ENABLED=

# --- Langfuse -- SMTP / email (optional; leave blank to disable) -------------
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=

# --- Langfuse -- first-run org/project/user bootstrap (optional) ------------
# If you seed a project here, LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY
# should match the LANGFUSE_PUBLIC_KEY/SECRET_KEY values above.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# --- Langfuse -- misc feature flags (optional; docker-compose.yml has safe
# inline defaults for all of these) -------------------------------------------
NEXTAUTH_URL=
TELEMETRY_ENABLED=
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=
LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

# --- tracepump (optional overrides; sane defaults are built in) --------------
TRACEPUMP_INTERVAL=
TRACEPUMP_OUT=
TRACEPUMP_STATE=
# Default false: tracepump is a faithful pipe by default and writes every
# trace byte-for-byte, LiteLLM health checks included. Set true to drop
# traces tagged litellm-internal-health-check (empty input, null user/session)
# before they skew per-user/per-session baselines downstream. This is the
# one field tracepump ever inspects; it never rewrites what it decides to keep.
TRACEPUMP_SKIP_HEALTHCHECKS=

# --- Elasticsearch / Kibana ---------------------------------------------------
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
# Generate with: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=
# Used by wiretapd (internal/esink). Defaults to the elastic superuser and
# http://localhost:9200 if left blank. Inside the wiretapd container,
# ELASTICSEARCH_URL is overridden in docker-compose.yml to
# http://elasticsearch:9200 -- same local-vs-container distinction as
# LANGFUSE_BASE_URL above.
ELASTICSEARCH_URL=
ELASTIC_USERNAME=
# Lab-only escape hatch for a self-signed/unconfigured TLS endpoint. Off
# (verification on) unless explicitly set to "true". Never enable this
# against anything reachable outside the machine running it.
ELASTICSEARCH_TLS_SKIP_VERIFY=

# --- wiretapd (optional overrides; sane defaults are built in) ---------------
# The index alias documents are written through; the index template and
# concrete index Bootstrap creates are both derived from this name.
WIRETAPD_INDEX_BASE=
# Path to the shared Langfuse NDJSON archive tracepump/wiretapd's own fetch
# stage writes and wiretapd's indexer reads. Defaults to
# /data/langfuse-traces.ndjson, matching TRACEPUMP_OUT above -- only
# override this if you've also overridden TRACEPUMP_OUT.
WIRETAPD_ARCHIVE=
# wiretapd's own checkpoints -- deliberately separate from
# TRACEPUMP_STATE, and from each other (see internal/pipeline's package
# doc for why fetch and index progress must not be conflated into one
# checkpoint). Inside the wiretapd container these are overridden in
# docker-compose.yml to live in the wiretapd_state volume.
WIRETAPD_FETCH_STATE=
WIRETAPD_INDEX_STATE=
